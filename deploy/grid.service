[Unit]
Description=GRID API (todo)
Documentation=https://github.com/<you>/todo
# MySQL 实例名按宝塔多版本工具的实际服务名改，不存在就先注释掉这一行
After=network.target mysql-8.0.service
Wants=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/todo/packages/server
EnvironmentFile=/www/wwwroot/todo/.env

# 堆上限写死在 ExecStart 里，不靠环境变量 —— 这样 systemctl cat 一眼能看到真实生效值。
#
# node 必须写绝对路径：systemd 不读 PATH，也不 source .bashrc，
# 所以 `node` 或 /usr/bin/node 在宝塔机器上多半是另一个版本（甚至不存在）。
# 用 `which node` 确认真实路径后替换下面这一行。
ExecStart=/www/server/nodejs/v22.22.0/bin/node --max-old-space-size=256 dist/index.js

Restart=always
RestartSec=3

# ── 内存上限兜底（默认关闭）──────────────────────────────────
# 这是可选项：有它才能"泄漏时自动重启"，没有不影响任何功能。
#
# 字段名按 systemd 版本选（语义相同，231 起改名）：
#   systemd >= 231（Alibaba Cloud Linux 3 / CentOS 8+ / Ubuntu 20.04+）
#       MemoryMax=512M
#   systemd = 219（CentOS 7，阿里云老镜像常见）
#       MemoryLimit=512M
#
# ⚠️ 但字段名对了也可能设不进去。实测 CentOS 7 / systemd 219 + cgroup v1
# 未启 memory controller 时，服务照常 active，每次 daemon-reload 只多一条：
#   grid.service:21: Invalid memory limit 536870912, ignoring: Invalid argument (-22)
# 这种情况注释掉即可（-22 是 EINVAL，内核拒绝了这次写入）。
#
# ⚠️ 另外**不要**把启动失败归咎于这一行。systemd 对"启动准备阶段失败"
# 一律冠以 `Failed with result 'resources'`，看着像资源限制，真实原因在
# journal 的**上一行**：
#   grid.service: Failed to load environment files: No such file or directory
#   grid.service: Failed to run 'start' task: No such file or directory
# 也就是 EnvironmentFile / WorkingDirectory 指错了。
# 排查顺序：`journalctl -u grid -n 30 --no-pager` 看那一行，别先动这里。
#MemoryMax=512M

# 日志
StandardOutput=append:/www/log/grid/api.log
StandardError=append:/www/log/grid/api.log

# 安全加固（自托管最低配）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
