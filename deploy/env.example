# ─────────────────────────────────────────────────────────────
# 生产环境模板。复制到仓库根目录：
#   cp deploy/env.example .env && vim .env
# 与根目录 .env.example（开发用）的区别只有三处：DB_URL / APP_ORIGIN / COOKIE_SECURE
# ─────────────────────────────────────────────────────────────

NODE_ENV=production

HOST=127.0.0.1
PORT=3000

# MySQL 8.0 独立实例（端口 3307），只绑 127.0.0.1
DB_URL=mysql://grid_rw:CHANGE_ME@127.0.0.1:3307/grid

# 必须与浏览器地址栏完全一致（含 https），否则 Origin 校验会 403
APP_ORIGIN=https://todo.stellamp.me

# 生产必须 true：__Host- 前缀的 Cookie 必须是 Secure，否则浏览器直接丢弃
COOKIE_SECURE=true

LOG_LEVEL=info
SESSION_TTL_DAYS=30

# ── Microsoft Graph（Outlook 日历）──────────────────────────
# 生成方式：openssl rand -base64 32
# 用它加密 Microsoft 的 access/refresh token（AES-256-GCM），库里不存明文
TOKEN_ENC_KEY=

# Azure 门户 → 应用注册 → 概述 → 应用程序(客户端) ID
MS_CLIENT_ID=
# 证书和密码 → 客户端密码 → 复制「值」列
MS_CLIENT_SECRET=
# common = 个人号与工作/学校号都接受
MS_TENANT=common
# 必须与 Azure 里注册的重定向 URI 逐字符一致（含 https、无尾斜杠）
MS_REDIRECT_URI=https://todo.stellamp.me/api/oauth/microsoft/callback
# offline_access 用于拿 refresh_token；缺了它令牌一小时后就失效且无法续期
MS_SCOPES=offline_access User.Read Calendars.ReadWrite
