# ─────────────────────────────────────────────────────────────
# 生产环境模板。复制到仓库根目录：
#   cp deploy/env.example .env && vim .env
# 与根目录 .env.example（开发用）的区别只有三处：DB_URL / APP_ORIGIN / COOKIE_SECURE
# ─────────────────────────────────────────────────────────────

NODE_ENV=production

HOST=127.0.0.1
PORT=3000

# MySQL 8.0 独立实例（端口 3307），只绑 127.0.0.1
DB_URL=mysql://grid_rw:CHANGE_ME@127.0.0.1:3307/grid

# 必须与浏览器地址栏完全一致（含 https），否则 Origin 校验会 403
APP_ORIGIN=https://todo.example.me

# 生产必须 true：__Host- 前缀的 Cookie 必须是 Secure，否则浏览器直接丢弃
COOKIE_SECURE=true

LOG_LEVEL=info
SESSION_TTL_DAYS=30

# 生成方式：openssl rand -base64 32
# M4 用它加密 Microsoft 的 access/refresh token（AES-256-GCM）
TOKEN_ENC_KEY=

# M4 接入 Outlook 时填（Azure 门户 → 应用注册）
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=https://todo.example.me/api/oauth/microsoft/callback
