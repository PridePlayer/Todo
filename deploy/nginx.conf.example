# GRID 的 nginx 配置
#
# 两种用法，按你的部署方式选一种。
#
# 【A】宝塔面板（本项目实际部署方式，推荐）
#     不要整段替换站点的「配置文件」。宝塔把证书配置夹在 #SSL-START / #SSL-END
#     之间，面板的「申请证书」「强制 HTTPS」「自动续期」都在改那个块；整段替换会让
#     这三个按钮全部失效，而且下次你在面板里点任何 SSL 开关时，
#     面板会按自己的模板重写文件，把这里的内容覆盖掉。
#
#     做法：宝塔 → 网站 → 站点设置 → 配置文件
#           ① 把顶部的 root 改成 /www/wwwroot/todo/apps/web/dist
#           ② 把下面【插入片段】整段粘进 server { } 内部（#SSL-END 之后即可）
#           ③ 保存（面板会自动 nginx -t 并 reload，报错会直接弹出来）
#
# 【B】裸 nginx（不用宝塔）
#     用文件末尾的【完整 server 块】，按注释改 server_name 与证书路径。


# ══════════════════════════════════════════════════════════════════
# 【插入片段】—— 粘到宝塔站点配置的 server { } 内部
# ══════════════════════════════════════════════════════════════════

    # 前端构建产物文件名带 hash，可以长缓存。
    #
    # 前缀必须用 ^~ ：宝塔默认带有
    #     location ~ .*\.(js|css)?$ { expires 12h; ... }
    # 这类正则 location。nginx 的匹配顺序是
    #     精确 = > ^~ 前缀 > 正则（按出现顺序）> 普通前缀
    # 写成普通 location /assets/ 会被那条正则抢走，缓存策略等于没写；
    # 而 ^~ 的含义正是"这个前缀最长匹配时，跳过正则检查"。
    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # API 反代到本机 Fastify（服务只监听 127.0.0.1:3000，不对外暴露）
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 首次同步要一次拉 30 天事件、可能连环翻页，默认 60s 有时不够
        proxy_read_timeout 90s;
        client_max_body_size 2m;

        # 设备令牌临期时服务端会静默轮换，新令牌走 x-device-token 响应头。
        # 服务端已带 cache-control: no-store，这里不额外关 buffering（关掉会拖慢普通接口）。
    }

    # SPA 回退：/quadrant、/habits、/calendar 这些前端路由在服务器上没有对应文件，
    # 不兜底就会 404。
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # gzip 若宝塔已在全局开过（nginx.conf 的 http 块里），这里再加会报
    # "duplicate directive"，所以默认注释。不确定就先别开，纯 JSON 不压缩也能用。
    # gzip on;
    # gzip_types text/css application/javascript application/json image/svg+xml;
    # gzip_min_length 1024;


# ══════════════════════════════════════════════════════════════════
