# 宝塔 → 网站 → 新建站点 todo.example.me
# 1) 把这个文件的内容填进站点的「配置文件」
# 2) 在宝塔申请 Let's Encrypt 证书，证书路径按实际改
# 3) 根目录指向仓库里的 apps/web/dist
#
# 与 docs/02-架构与技术方案.md §10.2 一致，额外加了 CSP（API 只返回 JSON，不影响接口）

server {
    listen 80;
    server_name todo.example.me;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name todo.example.me;

    ssl_certificate     /www/server/panel/vhost/cert/todo.example.me/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/todo.example.me/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;

    root /www/wwwroot/todo/apps/web/dist;
    index index.html;

    # 前端构建产物文件名带 hash，可以长缓存
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # SPA 回退：任何前端路由都回 index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # API 反代到本机 Fastify
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
        client_max_body_size 2m;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
