{
  "name": "@grid/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "pnpm --filter @grid/core build && tsx watch --clear-screen=false src/index.ts",
    "build": "pnpm --filter @grid/core build && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/cli/migrate.ts",
    "seed:user": "tsx src/cli/seed-user.ts",
    "reset:password": "tsx src/cli/reset-password.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@grid/core": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "mysql2": "^3.24.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
