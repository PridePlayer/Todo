# ─────────────────────────────────────────────────────────────
# 本地开发环境模板。复制为 .env 后即可 `pnpm dev`
#   cp .env.example .env
# 生产环境请用 deploy/env.example（Cookie 必须 Secure）
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# 服务端监听。只绑 127.0.0.1，公网入口永远是 nginx
HOST=127.0.0.1
PORT=3000

# 数据库。两种写法，启动时按前缀自动选驱动：
#   sqlite:./.data/grid.db                      → Node 内置 node:sqlite，零安装
#   mysql://grid_rw:pw@127.0.0.1:3307/grid      → 生产用 mysql2
# 相对路径以仓库根目录为基准。
DB_URL=sqlite:./.data/grid.db

# 前端来源。用于 Origin 校验与登录后跳转
APP_ORIGIN=http://localhost:5173

# Cookie。false 时用 grid_s（无 __Host- 前缀），true 时用 __Host-grid_s
COOKIE_SECURE=false

# debug | info | warn | error
LOG_LEVEL=debug

# 会话有效期（天）。滑动续期，绝对上限 90 天写死在代码里
SESSION_TTL_DAYS=30

# ── Microsoft Graph（Outlook 日历）──────────────────────────
# 三项（CLIENT_ID / CLIENT_SECRET / TOKEN_ENC_KEY）必须同时有值；
# 全部留空 = OAuth 功能关闭，登录、待办、打卡照常可用（接口返回 503）。
# 只填一部分会启动失败——半配置比不配置更难排查。

# Azure 门户 → 应用注册 → 概述 → 「应用程序(客户端) ID」
MS_CLIENT_ID=
# 证书和密码 → 客户端密码 → 复制「值」列（不是「密码 ID」，且只显示一次）
MS_CLIENT_SECRET=
# common = 个人 Microsoft 账号 + 工作/学校账号都接受
# 只允许单租户时填租户 id 或 xxx.onmicrosoft.com
MS_TENANT=common
# 留空则自动推导为 APP_ORIGIN + /api/oauth/microsoft/callback
# 本地开发若想直连后端，可显式写 http://localhost:3000/api/oauth/microsoft/callback
MS_REDIRECT_URI=
# offline_access 必须有，否则拿不到 refresh_token（一小时后就得重新授权）
MS_SCOPES=offline_access User.Read Calendars.ReadWrite
# 令牌用 AES-256-GCM 加密后才入库。生成：openssl rand -base64 32
TOKEN_ENC_KEY=
